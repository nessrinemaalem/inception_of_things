# -*- mode: ruby -*-
# vi: set ft=ruby :

# Avant de lancer : arreter la p1 (cd ../p1 && vagrant halt).
# Les deux environnements se disputent l'IP 192.168.56.110 et le nom de
# domaine libvirt "imaalemS".
ENV['VAGRANT_DEFAULT_PROVIDER'] = 'libvirt'

Vagrant.configure("2") do |config|
  config.vm.box = "debian/trixie64"

  # 9p : partage live sans demon NFS cote hote. Le provisioning y lit les
  # manifests (/vagrant/confs).
  config.vm.synced_folder ".", "/vagrant", type: "9p", accessmode: "squash"

  config.vm.define "imaalemS" do |server|
    server.vm.hostname = "imaalemS"
    server.vm.network "private_network", ip: "192.168.56.110"

    server.vm.provider "libvirt" do |lv|
      lv.default_prefix = ""
      lv.cpus = 1
      lv.memory = 1024
      # NE PAS mettre lv.graphics_type = "none" : avec vagrant-libvirt 0.11.2
      # cela retire aussi la carte video, et sans VGA SeaBIOS boucle
      # indefiniment sur l'enumeration du bus PCI. La VM tourne alors a 100%
      # de CPU sans jamais atteindre GRUB. Le VNC par defaut n'ouvre aucune
      # fenetre : on reste headless sans cette option.
    end

    server.vm.provision "shell", path: "scripts/k3s-server.sh"
  end
end
